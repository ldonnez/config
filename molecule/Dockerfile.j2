FROM {{ item.image }}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
        python3-apt \
        python3-setuptools \
        sudo \
    && rm -rf /var/lib/apt/lists/*

CMD ["bash", "-c", "while true; do sleep 10000; done"]
